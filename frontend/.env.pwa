# The standalone PWA build (`npm run build:pwa` = `vite build --mode pwa`), served from GitHub
# Pages — see docs/PWA_STANDALONE.md. Vite reads this file for that mode only. Public values;
# nothing secret belongs in here.

# No backend, no sign-in: the local profile only, with an IndexedDB durable copy (lib/standalone.js).
VITE_STANDALONE_WEB=1

# Exercise images/animations are third-party content that is not redistributed (NOTICE.md): they
# load from the upstream dataset on jsDelivr, pinned to a commit — the same address the mobile
# and demo builds use.
VITE_IMG_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/images/
VITE_GIF_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/videos/

# The "source code" link in Settings: the source of THIS modified version (AGPL-3.0 §13).
VITE_SOURCE_URL=https://github.com/Danialsafarli/opengym-pwa
